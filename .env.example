# Devpost and Devfolio APIs are public — no key needed
# Twitter/X search APIs — pick one or both:

# Option A: TwitterAPI.io (https://twitterapi.io)
# $0.15 per 1K tweets. Sign up, get API key, add credits.
TWITTERAPI_IO_KEY=your_twitterapi_io_key_here

# Option B: ScrapeBadger (https://scrapebadger.com)
# 1,000 free credits on signup. 1 credit base + 1 per tweet.
SCRAPEBADGER_API_KEY=your_scrapebadger_key_here
